{
  "name": "passly_api",
  "version": "6.0.0",
  "description": "The backend application for Passly, the open source password manager for teams",
  "repository": {
    "url": "https://github.com/Svaroh/passly_api"
  },
  "engines": {
    "node": ">=16.14.0",
    "npm": ">=8.3.1"
  },
  "keywords": [
    "API",
    "passly"
  ],
  "author": "Passbolt SA",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/Svaroh/passly_api",
  "devDependencies": {
    "@babel/runtime": "^7.27.0",
    "@babel/runtime-corejs3": "^7.26.10",
    "lockfile-lint": "^4.14.1",
    "openpgp": "^5.11.3",
    "passbolt-styleguide": "^5.16.1"
  },
  "scripts": {
    "copy:dependencies": "node ./scripts/copy-dependencies.js",
    "copy:styleguide": "node ./scripts/copy-styleguide.js",
    "copy:locales": "node ./scripts/copy-locales.js",
    "lint": "npm run lint:lockfile",
    "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts npm github.com --allowed-schemes \"https:\" \"git+ssh:\" --empty-hostname false"
  },
  "dependencies": {
    "micromatch": "^4.0.8",
    "react-router-dom": "^5.3.4"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "js-yaml": "^4.3.2"
  }
}
